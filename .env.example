GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Poziom "myslenia" modeli Gemini 3+: minimal, low, medium, high.
# Wyzej = dokladniej, ale dluzej i drozej (myslenie jest platne jak wyjscie).
GEMINI_THINKING_LEVEL=medium

# Tylko dla starych modeli 2.x (budzet w tokenach; -1 = model decyduje sam).
GEMINI_THINKING_BUDGET=8192

# Transkrypcja osobnym, szybszym modelem, rownolegle z dokumentacja.
# false = jedno wywolanie, model dokumentacji sam pisze transkrypcje.
SEPARATE_TRANSCRIPTION=true
TRANSCRIPTION_MODEL=gemini-3.8-flash

# Ile zatwierdzonych dokumentacji idzie do promptu jako wzorzec stylu. 0 = wylacz.
FEW_SHOT_LIMIT=3

# Kto moze sie zalogowac (adresy po przecinku). Puste = kazdy z kontem Google.
ALLOWED_EMAILS=

# Adres bazy. Puste = lokalny SQLite w data/mindscribe.db.
# Neon podaje string zaczynajacy sie od postgresql:// — mozna wkleic bez zmian.
DATABASE_URL=
