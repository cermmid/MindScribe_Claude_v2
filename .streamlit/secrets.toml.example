# Skopiuj do .streamlit/secrets.toml dla developmentu lokalnego,
# albo wklej w Streamlit Cloud → App settings → Secrets.
# Plik .streamlit/secrets.toml jest w .gitignore — NIGDY go nie commituj.

GEMINI_API_KEY = "wklej-tutaj-klucz-z-https://aistudio.google.com/apikey"
GEMINI_MODEL = "gemini-2.5-pro"

# Budżet tokenów "myślenia". 8192 to domyślna wartość Google dla 2.5 Pro.
# Niżej = taniej i gorzej, -1 = model decyduje sam (koszt nieprzewidywalny).
# Uwaga: te tokeny są płatne jak wyjście, przy Pro 10 USD za milion.
GEMINI_THINKING_BUDGET = 8192

# Ile zatwierdzonych notatek doklejamy jako wzorzec stylu. 0 wyłącza je zupełnie —
# przydatne, gdyby model zaczął przenosić treść ze starych wizyt do nowej notatki.
FEW_SHOT_LIMIT = 3

# Hasło do panelu właściciela (admin/app.py). To OSOBNY mechanizm niż logowanie
# specjalistów — panel pokazuje koszty i statystyki wszystkich, więc celowo
# chroni go inne poświadczenie.
admin_password = "długie-hasło-tylko-dla-Ciebie"

# ----- Logowanie użytkowników (Auth0 przez natywne st.login) -----
# cookie_secret: losowy, długi ciąg. Podpisuje ciasteczko sesji — zmiana wylogowuje
# wszystkich. Wygeneruj np. przez: python -c "import secrets; print(secrets.token_hex(32))"
#
# redirect_uri MUSI dokładnie odpowiadać adresowi aplikacji z końcówką /oauth2callback
# i być wpisany w Auth0 → Application → Allowed Callback URLs. Niezgodność tego pola
# to najczęstsza przyczyna "logowanie nie działa".
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "wygeneruj-losowy-długi-ciąg"

[auth.auth0]
client_id = "z-Auth0-Application-Settings"
client_secret = "z-Auth0-Application-Settings"
server_metadata_url = "https://TWOJA-DOMENA.us.auth0.com/.well-known/openid-configuration"

# ----- Baza danych -----
# Puste = lokalny SQLite w data/mindscribe.db (dev i testy działają bez serwera).
# Na produkcji: connection string z Neona — można wkleić bez zmian, prefiks
# postgresql:// jest zamieniany na postgresql+psycopg:// automatycznie.
DATABASE_URL = ""

# ----- Vertex AI (opcjonalnie, dla danych medycznych) -----
# Gdy USE_VERTEX_AI = true, klient ignoruje GEMINI_API_KEY i łączy się przez Google Cloud.
# Wymaga włączenia Vertex AI API w projekcie + Service Account z rolą "Vertex AI User".
USE_VERTEX_AI = false
GCP_PROJECT_ID = ""
GCP_LOCATION = "europe-west4"     # region UE (RODO); fallback: "europe-west1"

# Cały plik JSON klucza Service Account jako wielolinijkowy string TOML.
# UWAGA: użyj potrójnych cudzysłowów — JSON ma cudzysłowy i znaki nowej linii.
GOOGLE_APPLICATION_CREDENTIALS_JSON = """
"""
