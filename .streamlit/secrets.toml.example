# Skopiuj do .streamlit/secrets.toml dla developmentu lokalnego,
# albo wklej w Streamlit Cloud → App settings → Secrets.
# Plik .streamlit/secrets.toml jest w .gitignore — NIGDY go nie commituj.
#
# ⚠️ KOLEJNOŚĆ MA ZNACZENIE. W TOML wszystko, co stoi POD nagłówkiem w nawiasach
# kwadratowych ([auth], [auth.google]), należy do tej sekcji aż do następnego
# nagłówka. Ustawienie wpisane pod sekcją logowania znika z miejsca, w którym
# aplikacja go szuka — bez żadnego błędu. Dlatego wszystkie zwykłe ustawienia są
# NAD sekcjami logowania, a sekcje logowania są na samym końcu pliku.

# ----- Model -----
GEMINI_API_KEY = "wklej-tutaj-klucz-z-https://aistudio.google.com/apikey"
GEMINI_MODEL = "gemini-3.8-flash"

# Poziom "myślenia" modelu dokumentacji (Gemini 3+): minimal, low, medium, high.
# Wyżej = dokładniej, ale dłużej i drożej — myślenie jest płatne jak wyjście.
GEMINI_THINKING_LEVEL = "medium"

# Budżet myślenia w tokenach — działa wyłącznie ze starymi modelami 2.x.
GEMINI_THINKING_BUDGET = 8192

# Transkrypcja osobnym, szybszym modelem, równolegle z dokumentacją. Czas czekania
# to wtedy dłuższe z dwóch wywołań, a nie ich suma. false wraca do jednego
# wywołania, w którym model dokumentacji sam pisze też transkrypcję.
SEPARATE_TRANSCRIPTION = true
TRANSCRIPTION_MODEL = "gemini-3.8-flash"

# Ile zatwierdzonych dokumentacji doklejamy jako wzorzec stylu. 0 wyłącza je zupełnie —
# przydatne, gdyby model zaczął przenosić treść ze starych wizyt do nowej dokumentacji.
FEW_SHOT_LIMIT = 3

# ----- Kto może się zalogować -----
# Dostęp ustawiasz w Google Cloud: Google Auth Platform → Odbiorcy → Użytkownicy testowi.
# Dopóki klient OAuth jest w stanie "Testowanie", Google nie wpuści nikogo spoza tej listy.
# Ta lista to opcjonalna druga warstwa — pusta wpuszcza każdego, kogo wpuścił Google.
# Wypełnij ją dopiero, gdyby klient OAuth musiał przejść do produkcji.
ALLOWED_EMAILS = []

# Hasło do panelu właściciela (admin/app.py). To OSOBNY mechanizm niż logowanie
# specjalistów — panel pokazuje koszty i statystyki wszystkich, więc celowo
# chroni go inne poświadczenie.
admin_password = "długie-hasło-tylko-dla-Ciebie"

# ----- Baza danych -----
# Puste = lokalny SQLite w data/mindscribe.db (dev i testy działają bez serwera).
# Na Streamlit Cloud MUSI być ustawione — lokalny plik znika przy każdym restarcie.
# Connection string z Neona można wkleić bez zmian, prefiks postgresql:// jest
# zamieniany na postgresql+psycopg:// automatycznie.
DATABASE_URL = ""

# ----- Vertex AI (dla danych medycznych) -----
# Gdy USE_VERTEX_AI = true, klient ignoruje GEMINI_API_KEY i łączy się przez Google Cloud.
# Wymaga włączenia Vertex AI API w projekcie + Service Account z rolą "Vertex AI User".
# Darmowe API Gemini (GEMINI_API_KEY) może używać danych do trenowania modeli —
# przy prawdziwych pacjentach używaj Vertex AI.
USE_VERTEX_AI = false
GCP_PROJECT_ID = ""
GCP_LOCATION = "eu"     # cała UE (RODO); pojedyncze regiony jeszcze nie mają modeli 3.x

# Cały plik JSON klucza Service Account jako wielolinijkowy string TOML.
# UWAGA: użyj potrójnych cudzysłowów — JSON ma cudzysłowy i znaki nowej linii.
GOOGLE_APPLICATION_CREDENTIALS_JSON = """
"""

# ===== Sekcje logowania — ZAWSZE NA KOŃCU PLIKU (patrz uwaga na górze) =====
#
# cookie_secret: losowy, długi ciąg. Podpisuje ciasteczko sesji — zmiana wylogowuje
# wszystkich. Wygeneruj np.: python -c "import secrets; print(secrets.token_hex(32))"
#
# redirect_uri MUSI dokładnie odpowiadać adresowi aplikacji z końcówką /oauth2callback
# i być wpisany w kliencie OAuth w Google Cloud jako „Autoryzowany identyfikator URI
# przekierowania". Niezgodność to najczęstsza przyczyna "logowanie nie działa".
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "wygeneruj-losowy-długi-ciąg"

# Klient OAuth z Google Cloud → Interfejsy API i usługi → Dane logowania (patrz README).
[auth.google]
client_id = "XXXXXXXX.apps.googleusercontent.com"
client_secret = "z-klienta-OAuth-w-Google-Cloud"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
